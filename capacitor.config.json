{
  "appId": "com.hammadanwer.signsaathi",
  "appName": "Sign Saathi",
  "webDir": "dist",
  "backgroundColor": "#f6f4eb",
  "ios": {
    "contentInset": "never"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#f6f4eb",
      "showSpinner": true,
      "iosSpinnerStyle": "small",
      "spinnerColor": "#176b87"
    },
    "Keyboard": {
      "resize": "native"
    }
  }
}
